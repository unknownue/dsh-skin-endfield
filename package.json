{
  "name": "dsh-skin-endfield",
  "version": "0.1.0",
  "description": "Arknights: Endfield skin for the DeepSeek Harness Web GUI — industrial signal-yellow palette, technical frames, light detail cards and diamond markers, ported from the game's design language.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "assets/fonts",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "vendor:fonts": "pwsh -File scripts/vendor-fonts.ps1",
    "verify": "pwsh -File scripts/verify-all.ps1",
    "verify:client": "node scripts/verify-client.mjs",
    "verify:host": "node scripts/verify-host.mjs",
    "verify:settings": "node scripts/verify-settings-parity.mjs",
    "verify:install": "pwsh -File scripts/verify-install.ps1",
    "verify:composition": "node scripts/verify-composition.mjs",
    "verify:corners": "node scripts/verify-corners-live.mjs",
    "verify:focus": "node scripts/verify-focus-signature.mjs",
    "verify:toolblock": "node scripts/verify-tool-block-chrome.mjs",
    "verify:sidebar": "node scripts/verify-sidebar-chrome.mjs",
    "verify:typography": "node scripts/verify-typography-and-bubble.mjs",
    "inspect:dom": "node scripts/inspect-shell-dom.mjs",
    "inspect:green": "node scripts/probe-green.mjs",
    "inspect:composer": "node scripts/probe-composer-dom.mjs",
    "verify:accent-sheet": "node scripts/verify-accent-sheet.mjs",
    "verify:brackets": "node scripts/verify-brackets-live.mjs",
    "shots:brackets": "node scripts/probe-bracket-shots.mjs",
    "inspect:surfaces": "node scripts/probe-surface-bg.mjs",
    "smoke": "node scripts/smoke-browser.mjs",
    "showcase": "node scripts/showcase.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skin",
    "theme",
    "arknights",
    "endfield"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
