{
  "name": "dsh-skin-endfield",
  "version": "0.1.0",
  "description": "Arknights: Endfield skin for the DeepSeek Harness Web GUI — industrial signal-yellow palette, technical frames, light detail cards and diamond markers, ported from the game's design language.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "assets/fonts",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "vendor:fonts": "pwsh -File scripts/vendor-fonts.ps1",
    "verify": "pwsh -File scripts/verify-all.ps1",
    "verify:client": "node scripts/verify-client.mjs",
    "verify:host": "node scripts/verify-host.mjs",
    "verify:install": "pwsh -File scripts/verify-install.ps1",
    "smoke": "node scripts/smoke-browser.mjs",
    "showcase": "node scripts/showcase.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skin",
    "theme",
    "arknights",
    "endfield"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
