      "--dsw-alias-bg-layer-2":                     { "light": "#FFFFFF", "dark": "#2E2E2E", "reason": "surface-3" },
      "--dsw-alias-bg-layer-3":                     { "light": "#FAFAFA", "dark": "#35373C", "reason": "surface-4" },
