      "--dsw-alias-button-primary-dimmed":          { "light": "rgba(255,250,0,0.45)", "dark": "rgba(255,250,0,0.45)", "reason": "inferred" },
      "--dsw-alias-button-contrast-fill":           { "light": "#FFFFFF", "dark": "#FFFFFF", "reason": "反白高亮按钮（官方 Button_light = #FFF 底 + #000 字）" },
      "--dsw-alias-button-elevated-fill":           { "light": "#FFFFFF", "dark": "#35373C", "reason": "surface-4" },
      "--dsw-alias-button-floating-fill":           { "light": "#FFFFFF", "dark": "#2E2E2E", "reason": "surface-3" },
      "--dsw-alias-button-floating-hover":          { "light": "#FAFAFA", "dark": "#424242", "reason": "surface-5" },
      "--dsw-alias-button-ghost-active-fill":       { "light": "rgba(255,250,0,0.18)", "dark": "rgba(255,250,0,0.14)", "reason": "inferred" },
      "--dsw-alias-button-ghost-active-hover":      { "light": "rgba(255,250,0,0.26)", "dark": "rgba(255,250,0,0.22)", "reason": "inferred" },
      "--dsw-alias-button-ghost-active-border":     { "light": "#FFFA00", "dark": "#FFFA00", "reason": "inferred" },
      "--dsw-alias-button-info-fill":               { "light": "#00FFA2", "dark": "#00FFA2", "reason": "mint" },
      "--dsw-alias-button-info-hover":              { "light": "#4DFFBE", "dark": "#4DFFBE", "reason": "inferred" },
      "--dsw-alias-button-tool-bar-fill":           { "light": "#FFFFFF", "dark": "#2E2E2E", "reason": "inferred" },
      "--dsw-alias-button-tool-bar-fill-invisible": { "light": "rgba(255,255,255,0)", "dark": "rgba(46,46,46,0)", "reason": "inferred" },
      "--dsw-alias-button-tool-bar-hover":          { "light": "#F2F2F2", "dark": "#424242", "reason": "inferred" },
