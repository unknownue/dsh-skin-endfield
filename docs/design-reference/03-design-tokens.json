      "--dsw-alias-link":                           { "light": "#007A4E", "dark": "#00FFA2", "reason": "mint 作链接/次强调；浅色模式压暗" },
      "--dsw-alias-state-success-primary":          { "light": "#007A4E", "dark": "#00FFA2", "reason": "mint（官方色标条含此色）" },
