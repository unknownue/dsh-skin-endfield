      "--dsw-alias-bg-mask-3":                      { "light": "rgba(0,0,0,0.14)", "dark": "rgba(255,255,255,0.14)", "reason": "inferred" },
      "--dsw-alias-bg-multi-select":                { "light": "rgba(255,250,0,0.28)", "dark": "rgba(255,250,0,0.22)", "reason": "信号黄多选底色" },
      "--dsw-alias-bg-skeleton":                    { "light": "#EDEDED", "dark": "#2E2E2E", "reason": "inferred" },
      "--dsw-alias-border-l1":                      { "light": "#D9D9D9", "dark": "#2E2E2E", "reason": "发丝线" },
      "--dsw-alias-border-l2":                      { "light": "#D9D9D9", "dark": "#35373C", "reason": "面板描边（0.375rem solid #35373C 为官方高频）" },
      "--dsw-alias-border-l2-darkmode-thin":        { "light": "#E7E7E7", "dark": "#3A3A3A", "reason": "更细的深色描边" },
      "--dsw-alias-border-l3":                      { "light": "#CCCCCC", "dark": "#424242", "reason": "抬起层描边" },
      "--dsw-alias-border-l4":                      { "light": "#B3B3B3", "dark": "#4D4D4D", "reason": "inferred" },
