      "--dsw-alias-label-secondary":                { "light": "#424242", "dark": "#D9D9D9", "reason": "D9D9D9 出现 33 次" },
      "--dsw-alias-label-tertiary":                 { "light": "#666666", "dark": "#999999", "reason": "#999 出现 19 次" },
      "--dsw-alias-label-caption":                  { "light": "#7E7E7E", "dark": "#7E7E7E", "reason": "muted" },
      "--dsw-alias-label-dimmed":                   { "light": "#A6A6A6", "dark": "#666666", "reason": "muted-alt" },
      "--dsw-alias-brand-primary":                  { "light": "#E6E000", "dark": "#FFFA00", "reason": "信号黄；浅色模式略压暗以保对比" },
