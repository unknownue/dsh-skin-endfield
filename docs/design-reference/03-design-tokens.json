      "--dsw-alias-label-primary-bluish":           { "light": "#191919", "dark": "#FAFAFA", "reason": "inferred" },
      "--dsw-alias-label-primary-dimmed":           { "light": "#424242", "dark": "#D9D9D9", "reason": "文字次色" },
