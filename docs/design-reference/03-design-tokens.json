{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "endfield-design-tokens",
  "version": "0.1.0",
  "description": "《明日方舟：终末地》设计令牌。raw 段是官方取值（带来源与证据），dsl 段是映射到 DSH Web GUI 主题令牌的建议覆盖值。实现时以 dsl 段为准，raw 段仅供追溯。",
  "provenance": {
    "official-css": "官网 CSS bundle（web-static.hg-cdn.com/endfield/official-v4/_next/static/css/*.css），共 10 个文件 400,919 字符，2026-09 抓取",
    "official-asset": "官网 CSS 引用的素材文件（165 个），本机取样",
    "official-copy": "官方公告 API 97 条 + 官网正文",
    "community": "社区设计分析文章（见 04-reference-sources.md）",
    "inferred": "无直接证据的推断值"
  },

  "raw": {
    "color": {
      "accent": {
        "signal-yellow": { "hex": "#FFFA00", "source": "official-css", "evidence": "CSS 出现 57 次；color-bar.png 取样一致", "role": "主强调：选中态/进度条/hover/装饰块" },
        "signal-yellow-glow": { "hex": "#FFF000", "source": "official-css", "evidence": "10 次", "role": "发光变体" },
        "signal-yellow-bright": { "hex": "#FDFD1F", "source": "official-css", "evidence": "6 次", "role": "变体" },
        "signal-yellow-bright2": { "hex": "#FFFF21", "source": "official-css", "evidence": "3 次", "role": "变体" },
        "triangle-yellow": { "hex": "#FCFC1F", "source": "official-asset", "evidence": "triangles.svg 的 fill 属性", "role": "三角母题专用" },
        "amber": { "hex": "#FFCC1A", "source": "official-css", "evidence": "1 次", "role": "暖黄变体" }
      },
      "cmyk-colorbar": {
        "note": "官方 color-bar.png（18x113px）实测五色，即强调色体系本身",
        "magenta": { "hex": "#FF1AAC", "source": "official-asset", "evidence": "色标条取样 + CSS 6 次" },
        "mint": { "hex": "#01FFA2", "source": "official-asset", "evidence": "色标条取样；CSS 写作 #00FFA2，9 次" },
        "yellow": { "hex": "#FFFA00", "source": "official-asset", "evidence": "色标条取样" },
        "gray": { "hex": "#D9D9D9", "source": "official-asset", "evidence": "色标条取样" },
        "key": { "hex": "#000000", "source": "official-asset", "evidence": "色标条取样" }
      },
      "magenta-alt": { "hex": "#FF00F0", "source": "official-css", "evidence": "3 次", "role": "点缀变体" },
      "surface-dark": {
        "footer": { "hex": "#101010", "source": "official-css", "evidence": "官网 footer 背景声明", "role": "页脚/最底栏" },
        "sunken": { "hex": "#141414", "source": "official-css", "evidence": "4 次", "role": "最深内嵌区" },
        "canvas": { "hex": "#191919", "source": "official-css", "evidence": "深色最高频，85 次", "role": "主深色背景" },
        "surface-2": { "hex": "#1F1F22", "source": "official-css", "evidence": "4 次；同时是 45 度斜线填充色", "role": "表面层" },
        "surface-3": { "hex": "#2E2E2E", "source": "official-css", "evidence": "6 次", "role": "面板" },
        "surface-4": { "hex": "#35373C", "source": "official-css", "evidence": "15 次；略带冷蓝调", "role": "面板/次级表面" },
        "surface-5": { "hex": "#424242", "source": "official-css", "evidence": "9 次", "role": "抬起层" }
      },
      "text": {
        "primary": { "hex": "#FFFFFF", "source": "official-css", "evidence": "95 次" },
        "primary-alt": { "hex": "#FAFAFA", "source": "official-css", "evidence": "10 次" },
        "primary-alt2": { "hex": "#F2F2F2", "source": "official-css", "evidence": "13 次" },
        "secondary": { "hex": "#D9D9D9", "source": "official-css", "evidence": "33 次" },
        "tertiary": { "hex": "#B3B3B3", "source": "official-css", "evidence": "8 次" },
        "tertiary-alt": { "hex": "#A6A6A6", "source": "official-css", "evidence": "5 次" },
        "quaternary": { "hex": "#999999", "source": "official-css", "evidence": "19 次" },
        "muted": { "hex": "#7E7E7E", "source": "official-css", "evidence": "4 次" },
        "muted-alt": { "hex": "#666666", "source": "official-css", "evidence": "10 次；也是 deco.svg 的 fill" }
      },
      "line": {
        "hairline-light-1": { "hex": "#E7E7E7", "source": "official-css", "evidence": "1px solid 高频" },
        "hairline-light-2": { "hex": "#E5E5E5", "source": "official-css", "evidence": "13 次" },
        "hairline-light-3": { "hex": "#D9D9D9", "source": "official-css", "evidence": "33 次；虚线规与 1px solid 都用它" },
        "hairline-light-4": { "hex": "#CCCCCC", "source": "official-css", "evidence": "12 次" }
      }
    },

    "typography": {
      "families": {
        "display-latin": { "name": "Novecentosanswide", "weights": ["Medium", "DemiBold", "Bold"], "source": "official-css", "role": "拉丁标题/数字/标签；最标志性" },
        "ui-latin": { "name": "Gilroy", "weights": ["Light", "Medium", "ExtraBold"], "source": "official-css", "role": "拉丁正文/UI" },
        "base-latin": { "name": "Roboto", "weights": ["Regular", "Black"], "source": "official-css" },
        "numeric-alt": { "name": "SpaceGrotesk", "weights": ["Regular"], "source": "official-css" },
        "display-special": { "name": "ProtestStrike", "weights": ["Regular"], "source": "official-css", "role": "极少量的压缩模板体展示字" },
        "cjk": { "name": "HarmonyOS Sans SC", "weights": ["Bold"], "source": "official-css", "role": "中文标题（站点以 SansRegular/Medium/Bold/Black 别名加载）" }
      },
      "system-fallback": "Segoe UI, Roboto, Helvetica Neue, Arial, PingFang SC, PingFang TC, Microsoft YaHei, Microsoft JhengHei, Hiragino Sans GB, Hiragino Kaku Gothic Pro, Yu Gothic UI, Meiryo, Apple SD Gothic Neo, Malgun Gothic, Leelawadee UI, Thonburi, Noto Sans, sans-serif",
      "open-substitutes": {
        "display": "\"Novecento Sans Wide\", Michroma, Orbitron, \"Saira Semi Condensed\", sans-serif",
        "ui": "Jost, Poppins, Montserrat, system-ui, sans-serif",
        "cjk": "\"HarmonyOS Sans SC\", \"HarmonyOS Sans\", \"Source Han Sans SC\", \"Noto Sans SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
        "mono": "\"JetBrains Mono\", \"IBM Plex Mono\", \"Roboto Mono\", ui-monospace, monospace"
      },
      "rules": {
        "uppercase-latin-labels": { "value": true, "source": "official-css", "evidence": "text-transform:uppercase 出现 12 次" },
        "display-letter-spacing": { "value": "-0.02em ~ -0.1em（含 -1px / -0.58rem）", "source": "official-css", "evidence": "大标题负字距是官方习惯" },
        "small-label-letter-spacing": { "value": "0.05em（官方竖排小标签）；overline 建议 0.12em", "source": "official-css / inferred" },
        "font-weight-declarations": { "value": 400, "source": "official-css", "evidence": "12 次；因为使用独立字重文件而非数值字重" },
        "glow": { "value": "text-shadow: 0 0 10px #fff000", "source": "official-css" },
        "scale-rem": { "value": [1, 1.125, 1.25, 1.375, 1.5, 1.625, 1.75, 1.875, 2, 2.25, 2.5, 2.625, 3, 3.5, 3.75, 4.5, 4.875, 8.125], "source": "official-css", "evidence": "font-size 频次由高到低" },
        "viewport-scaling": { "value": "html.style.fontSize = 16 * min(vw/2560, vh/1440)", "source": "official-css", "evidence": "官网内联脚本；设计画布 2560x1440 横屏 / 1080x1920 竖屏" }
      }
    },

    "shape": {
      "radius": {
        "default": "0（直角）",
        "control": "2px / 4px（0.125rem / 0.25rem；0.25rem 出现 24 次）",
        "pill": "1.875rem ~ 3.375rem（仅标签）",
        "circle": "50%（圆点）",
        "source": "official-css"
      },
      "border": {
        "hairline": "1px solid",
        "panel": "0.375rem solid #35373C（12 次）",
        "dashed-rule": "0.125rem dashed #D9D9D9（10 次）",
        "source": "official-css"
      },
      "shadow": {
        "button": "0 0 0.75rem rgba(0,0,0,0.25)",
        "deco-glow": "drop-shadow(0 0 0.25rem #FFF)",
        "source": "official-css"
      },
      "clip-path": {
        "arrow": "polygon(0 20%, 100% 50%, 0 80%, 0 80%)",
        "reveal": "polygon(0 0, 0 0, 0 100%, 0 100%)",
        "source": "official-css"
      }
    },

    "texture": {
      "hatching-45": { "css": "repeating-linear-gradient(-45deg, #1F1F22, #1F1F22 3px, transparent 0, transparent 6px)", "source": "official-css", "role": "选中项背景" },
      "bars-vertical": { "css": "repeating-linear-gradient(90deg, #B2B2B2 0, 0.375rem, transparent 0, 0.5625rem)", "source": "official-css", "role": "条码/梯格纹理" },
      "technical-frame": { "asset": "block-bg.svg", "spec": "方框描边 + 左上到右下对角线，stroke #000，stroke-width 2", "source": "official-asset" },
      "contour": { "asset": "subpage-deco-lb.png / utton-texture.*.png", "spec": "极淡嵌套等高线地形底纹", "source": "official-asset" },
      "dot-matrix": { "asset": "deco.svg", "spec": "7.09 单位方块错排矩阵，fill #666", "source": "official-asset" },
      "pixel-stair": { "asset": "th-deco-rt.svg", "spec": "29.1 单位方块阶梯阵列（四角装饰）", "source": "official-asset" },
      "triangles": { "asset": "triangles.svg", "spec": "3 个三角构成菱格，fill #FCFC1F", "source": "official-asset" },
      "colorbar": { "asset": "color-bar.png", "spec": "18x113px，五色 CMYK 色标", "source": "official-asset" },
      "blueprint-lineart": { "asset": "section_divider_icon_lore.png", "spec": "等轴测螺栓/螺母/螺纹杆线描，带剖面线与虚线尺寸标注", "source": "official-asset" },
      "button-texture": { "asset": "button-texture.*.png", "spec": "按钮叠加贴图", "source": "official-asset" }
    },

    "motion": {
      "flash-in": { "value": "1s ease-out forwards; 0% { opacity: 0 }", "source": "official-css", "evidence": "官网多个章节的 *_flashing keyframes", "role": "章节/面板激活时闪入" },
      "loading-fade-in": { "value": "0.6s cubic-bezier(1, 0, 0.7, 1) 0.5s forwards", "source": "official-css", "evidence": "__00-Loading_fadeIn", "role": "加载页淡入" },
      "activity-shake": { "value": "2s ease-in-out infinite", "source": "official-css", "role": "活动角标微抖" },
      "background-breath": { "value": "同 downloadBgBreath", "source": "official-css", "role": "背景呼吸" },
      "scroll-tip": { "value": "1.6s infinite", "source": "official-css", "role": "滚动提示浮动" },
      "spinner": { "value": "1.5s linear infinite", "source": "official-css", "evidence": "OrigQuery_rotate" },
      "transition-default": { "value": "0.3s", "source": "official-css", "evidence": "Pagination_block / Header_navItem / naviDot 统一 .3s" },
      "wipe-reveal": { "value": "clip-path 宽度 0 -> 100%", "source": "official-css" },
      "typewriter": { "value": "逐行/逐字显现", "source": "official-css", "evidence": "codePrinter 类名（位置 left:0; top:6.9375rem）" },
      "easing": {
        "default": "cubic-bezier(0.25, 0.8, 0.25, 1)",
        "sharp": "cubic-bezier(0.4, 0, 0.2, 1)",
        "source": "official-css / inferred"
      }
    },

    "copy-conventions": {
      "block-prefix": "//",
      "section-header": "▼//",
      "sub-item": "■",
      "system-name": "「」",
      "item-reward": "【】",
      "bullet": "•",
      "footnote": "※",
      "breadcrumb": " - ",
      "protocol-number": "Chapter Ⅰ Process I / 第二章 - 进程Ⅵ",
      "counter": "010 / 010（零填充 + 空格 + 斜杠）",
      "vertical-tag": "/// ARKNIGHTS: ENDFIELD",
      "source": "official-copy（97 条官方公告 + 官网正文；▼ 42 次、// 42 次、「」134 次、【】73 次）"
    }
  },

