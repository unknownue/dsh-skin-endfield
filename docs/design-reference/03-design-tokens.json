      "--dsw-alias-state-warn-primary":             { "light": "#B3A800", "dark": "#FFFA00", "reason": "警示由信号黄承担" },
      "--dsw-alias-state-warn-secondary":           { "light": "#8C8400", "dark": "#FFF000", "reason": "inferred" },
